# Copiar a .env y completar con valores reales.
# .env está en .gitignore — nunca lo commitees.

# Subdominio público que usará la demo (registro A → IP pública del VPS)
DEMO_DOMAIN=demo.rafex.io

# VPS donde corre rathole server + certbot
VPS_HOST=203.0.113.10
VPS_SSH_USER=root
VPS_SSH_PORT=22

# Bastion — donde corren los contenedores FHS reales
BASTION_HOST=192.168.1.139
BASTION_SSH_USER=rafex
# Alias de ~/.ssh/config si se accede vía jump host, dejar vacío si no aplica
BASTION_SSH_ALIAS=bastion-usb-wifi

# Token compartido entre rathole server y client — generar con:
#   openssl rand -hex 32
RATHOLE_TOKEN=cambiar-por-un-token-largo-aleatorio

# PeerIDs reales de Atlas y Navigator (no cambian — misma identidad libp2p
# que en LAN, ver ~/certs y logs de los contenedores en Bastion)
ATLAS_PEER_ID=12D3KooWL2kvLw4MgPbTTpgKBMsHfVjnpp26AVL54VwWkantYHoL
NAVIGATOR_PEER_ID=12D3KooWJNDdrDDeJS15GyrEyqzuXzdZF5f1UXKTQGZEHPfrVdsi

# Puertos públicos en el VPS (rathole los expone; no tienen que coincidir
# con los puertos internos de Bastion, pero por simplicidad se usan los mismos)
PORT_PORTAL_CHAT=443
PORT_ATLAS=4001
PORT_NAVIGATOR=4010
PORT_RATHOLE_CONTROL=2333
