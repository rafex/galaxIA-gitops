# Unidad systemd para rathole client en Bastion.
# Instalar:
#   sudo cp rathole-client.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rathole-client
#
# Ajustar ExecStart si el binario o el client.toml quedan en otra ruta.
# Corre como el usuario normal (rafex), no root — mismo patrón que los
# contenedores podman rootless ya usados para el stack FHS.

[Unit]
Description=rathole client (túnel hacia el VPS de la demo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rathole /home/rafex/galaxia-gitops/rathole/client.toml
Restart=on-failure
RestartSec=5
User=rafex
WorkingDirectory=/home/rafex/galaxia-gitops/rathole

[Install]
WantedBy=multi-user.target
