direction: down

classes: {
  host: {
    style: {
      fill: "#F5F7FA"
      stroke: "#5B6B7F"
      border-radius: 6
      font-size: 15
      bold: true
    }
  }
  ok: {
    style: {
      fill: "#E6F4EA"
      stroke: "#2E7D32"
      border-radius: 4
      font-size: 12
    }
  }
  viejo: {
    style: {
      fill: "#FFF6DB"
      stroke: "#B7791F"
      border-radius: 4
      font-size: 12
    }
  }
  caido: {
    style: {
      fill: "#FDECEA"
      stroke: "#C62828"
      stroke-width: 2
      border-radius: 4
      font-size: 12
    }
  }
  enlace: {
    style: {
      stroke: "#2E7D32"
      stroke-width: 2
    }
  }
  roto: {
    style: {
      stroke: "#C62828"
      stroke-width: 2
      stroke-dash: 5
      font-color: "#C62828"
    }
  }
}

